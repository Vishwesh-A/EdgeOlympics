# Vast only: private Supabase backend credentials (chmod 600)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key
# On Vast after the private dataset is finalized
LABELS_FILE=/workspace/edge-olympics/private/labels.npy
DATASET_SHA256=64-character-sha256-of-data.npz

# Worker identity
PI_ID=pi-01
WORKER_ID=prelim-worker-1
# Pi workers use only these API credentials; keep Supabase credentials on Vast.
PI_API_URL=https://your-control-plane.example.com
PI_API_TOKEN=unique-secret-for-this-pi

# Benchmarking limits
MAX_MB=50.0
TIMEOUT_S=120
MEM_CAP_MB=1200.0
TEMP_LIMIT_C=75.0

# Pi-only input dataset path (no labels on Pis)
DATASET_DIR=/opt/dataset

# Polling configuration
POLL_INTERVAL_S=5.0
HEARTBEAT_INTERVAL_S=10.0

# Model specifications
INPUT_SHAPE=1,128,128,1
OUTPUT_SHAPE=1,8
WARMUP_RUNS=5

# Prelim constraints
PRELIM_TIMEOUT_S=10
PRELIM_MEM_CAP_MB=500.0
