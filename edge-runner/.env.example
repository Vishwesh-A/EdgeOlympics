# Supabase credentials (keep service role key secret, chmod 600 on device)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Worker identity
PI_ID=pi-01
WORKER_ID=prelim-worker-1

# Benchmarking limits
MAX_MB=25.0
TIMEOUT_S=120
MEM_CAP_MB=1200.0
TEMP_LIMIT_C=75.0

# Dataset and storage paths
DATASET_DIR=/opt/dataset

# Polling configuration
POLL_INTERVAL_S=5.0
HEARTBEAT_INTERVAL_S=10.0

# Model specifications
INPUT_SHAPE=1,32,32,3
OUTPUT_SHAPE=1,10
WARMUP_RUNS=5

# Prelim constraints
PRELIM_TIMEOUT_S=10
PRELIM_MEM_CAP_MB=500.0
